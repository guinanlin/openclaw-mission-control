# Base URL for frontend -> backend API calls.
# - Empty: same-origin relative paths (/api/v1/...), Next rewrites to backend (works for localhost + LAN).
# - Or set full URL e.g. http://localhost:8000 or http://YOUR_LAN_IP:8000 if not using rewrites.
NEXT_PUBLIC_API_URL=

# Auth mode: clerk or local.
# - clerk: Clerk sign-in flow
# - local: shared bearer token entered in UI
NEXT_PUBLIC_AUTH_MODE=local

# Set to true to disable full-page reload on org switch (storage/BroadcastChannel).
# Use when debugging unexpected periodic reloads; if reloads stop, the cause was org-switch sync.
# NEXT_PUBLIC_DISABLE_ORG_SWITCH_RELOAD=false

# Clerk auth (used when NEXT_PUBLIC_AUTH_MODE=clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/boards
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/
